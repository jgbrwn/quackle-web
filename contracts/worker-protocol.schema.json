{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jgbrwn/quackle-web/blob/main/contracts/worker-protocol.schema.json",
  "title": "Quackle engine worker protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/workRequest" },
    { "$ref": "#/$defs/cancelRequest" },
    { "$ref": "#/$defs/workerEvent" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workRequest": {
      "type": "object",
      "required": ["protocol", "id", "op", "deadline_ms", "seed", "payload"],
      "properties": {
        "protocol": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "op": {
          "enum": [
            "validate_position",
            "generate_moves",
            "validate_move",
            "analyze"
          ]
        },
        "deadline_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    },
    "cancelRequest": {
      "type": "object",
      "required": ["protocol", "id", "op", "payload"],
      "properties": {
        "protocol": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "op": { "const": "cancel" },
        "payload": {
          "type": "object",
          "required": ["target_id"],
          "properties": {
            "target_id": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "message": { "type": "string", "maxLength": 1024 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    },
    "workerEvent": {
      "type": "object",
      "required": ["protocol", "id", "event"],
      "properties": {
        "protocol": { "const": 1 },
        "id": { "type": ["string", "null"], "maxLength": 128 },
        "event": {
          "enum": [
            "ready",
            "started",
            "progress",
            "result",
            "cancelled",
            "error"
          ]
        },
        "payload": { "type": "object" },
        "error": { "$ref": "#/$defs/error" }
      },
      "allOf": [
        {
          "if": { "properties": { "event": { "const": "error" } } },
          "then": { "required": ["error"] },
          "else": { "required": ["payload"] }
        }
      ],
      "additionalProperties": false
    }
  }
}
